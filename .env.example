# ==============================================================================
# World Bank Metadata Editor — Docker Environment Configuration
# Copy this file to .env and customize before running `docker compose up -d`
# ==============================================================================

COMPOSE_PROJECT_NAME=metadata_editor
TZ=UTC

# ------------------------------------------------------------------------------
# 1. Release / Build Version Settings
# ------------------------------------------------------------------------------
# "latest" automatically resolves the latest official GitHub Release tag during build.
# You can also pin a specific release tag (e.g., v1.4.0) or branch (e.g., main).
EDITOR_REPO=worldbank/metadata-editor
EDITOR_VERSION=latest

FASTAPI_REPO=worldbank/metadata-editor-fastapi
FASTAPI_VERSION=latest

# Set to "true" to install optional AI Metadata Reviewer dependencies in FastAPI
INSTALL_REVIEWER=false

# ------------------------------------------------------------------------------
# 2. Web Server & Application Settings
# ------------------------------------------------------------------------------
# Host port mapped to Nginx inside the editor container
APP_PORT=8080

# Optional explicit public base URL (with trailing slash), e.g. https://metadata.example.org/
# Leave empty to auto-detect from incoming HTTP Host / X-Forwarded-Proto headers.
APP_BASE_URL=

# Enable Clean URLs (removes index.php from generated links)
CLEAN_URLS=true

# Strong random string for CodeIgniter session/cookie encryption (CHANGE IN PRODUCTION!)
APP_ENCRYPTION_KEY=ChangeThisEncryptionKeyInProd99!

# Set COOKIE_SECURE=true when running behind HTTPS in production
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=

# CodeIgniter log verbosity: 0=Off, 1=Error (recommended), 2=Debug, 3=Info, 4=All
LOG_THRESHOLD=1

# ------------------------------------------------------------------------------
# 3. Database Settings (MySQL 8.0 default; compatible with MariaDB 10.11+)
# ------------------------------------------------------------------------------
DB_IMAGE=mysql:8.0
DB_HOST=db
DB_PORT=3306
DB_NAME=metadata_editor
DB_USER=editor_user
DB_PASSWORD=editor_change_me
DB_ROOT_PASSWORD=root_change_me
DB_DEBUG=false

# ------------------------------------------------------------------------------
# 4. Zero-Touch Quick Start & Automatic Migrations
# ------------------------------------------------------------------------------
# AUTO_INSTALL=true automatically imports schema.mysql.sql on first boot and creates
# the initial Site Administrator account below.
# Set AUTO_INSTALL=false if you prefer to run the interactive browser wizard at /install.
AUTO_INSTALL=true

# AUTO_MIGRATE=true automatically runs `php index.php cli/migrate latest` on every
# container start so new release migrations are always applied seamlessly.
AUTO_MIGRATE=true

# Initial Site Administrator credentials (used on first boot when AUTO_INSTALL=true)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Administrator

# Optional: Seed an initial 32+ character REST API key (`X-API-KEY`) for the Admin user
# so automated scripts can call `/api/*` immediately on first boot.
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 5. PHP & Background Worker Resource Limits
# ------------------------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_POST_MAX_SIZE=2000M
PHP_UPLOAD_MAX_FILESIZE=2000M

WORKER_MEMORY_LIMIT=1024M
WORKER_POLL_INTERVAL=5
WORKER_MAX_JOBS=50

# ------------------------------------------------------------------------------
# 6. Outbound Email (SMTP) Settings
# ------------------------------------------------------------------------------
SMTP_PROTOCOL=smtp
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_EMAIL=noreply@example.org
SMTP_CRYPTO=
SMTP_AUTH=

# ------------------------------------------------------------------------------
# 7. Production Host Storage Path (used with docker-compose.prod.yml)
# ------------------------------------------------------------------------------
HOST_STORAGE_ROOT=./data
PROD_BIND_IP=0.0.0.0
DB_MEMORY_LIMIT=2G
FASTAPI_MEMORY_LIMIT=4G
EDITOR_CONTAINER_MEMORY_LIMIT=2G
WORKER_CONTAINER_MEMORY_LIMIT=2G
